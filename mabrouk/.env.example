# Public base URL (used in OG images, WhatsApp messages, host links).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://mabrouk.example

# Signs the PIN-gate cookie. Use a long random string in production.
MABROUK_SECRET=

# Optional: when both are set, RSVPs and view events go to Supabase
# (run supabase/schema.sql first). Otherwise a local JSON file in .data/ is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
